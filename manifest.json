{
  "manifest_version": 3,
  "name": "Retention",
  "version": "1.0",
  "description": "Flashcard system to organize terms into custom study decks, with quizzes and CSV import/export.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Retention"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "contextMenus",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "347038652030-30e99l44rnlrk380f33frv6uv738a6co.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  }
}